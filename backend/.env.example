# Database (docker-compose sets this automatically to the postgres service)
DATABASE_URL=postgresql://jagriti:jagriti@localhost:5432/jagriti_db

# JWT signing secret - CHANGE THIS before any real deployment
SECRET_KEY=change_me_in_production

# --- Optional external services ---
# Leave GEMINI_API_KEY empty to run fully offline in DEMO MODE (DemoAIService).
# Set it to use the real Gemini-backed assistant (GeminiAIService).
GEMINI_API_KEY=

# Leave empty to use the offline keyword-based DemoRetriever for RAG.
QDRANT_URL=

# Leave empty to use the offline seeded facility directory (DemoMapService).
MAPS_API_KEY=
